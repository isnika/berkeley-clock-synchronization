<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Berkeley.Windows.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.caption"><Setter Property="Foreground" Value="#A5B4CB"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#18263B"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/></Style>
    <Style Selector="Button"><Setter Property="Padding" Value="12,8"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="TextBox"><Setter Property="MinWidth" Value="100"/></Style>
    <Style Selector="DataGrid"><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="RowHeight" Value="34"/></Style>
  </Application.Styles>
</Application>
